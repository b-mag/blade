<Application x:Class="Blade.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:Blade.Desktop.Infrastructure"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <inf:VisibleWhenConverter x:Key="VisibleWhen"/>
            <inf:StatusBrushConverter x:Key="StatusBrush"/>
            <inf:KindBrushConverter x:Key="KindBrush"/>
            <inf:MsToWidthConverter x:Key="MsToWidth"/>
            <inf:PercentConverter x:Key="Percent"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
