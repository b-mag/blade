<UserControl x:Class="Blade.Desktop.Views.AskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Blade.Desktop.Views">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Title + question -->
        <StackPanel Grid.ColumnSpan="2">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" AutomationProperties.Name="Under the Hood" Style="{StaticResource ToggleChip}" IsChecked="{Binding ShowTrace}" IsEnabled="{Binding HasTrace}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/><TextBlock Text="Under the Hood"/></StackPanel>
                </ToggleButton>
                <StackPanel>
                    <TextBlock Style="{StaticResource H1}" Text="Ask BLADE"/>
                    <TextBlock Style="{StaticResource MutedText}" Text="Plain-English investigative search across RMS, CAD, field interviews, LPR, jail bookings and pawn records — answered with citations."/>
                </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Command="{Binding AskCommand}" Margin="8,0,0,0" Padding="20,8" IsDefault="True" AutomationProperties.Name="Run question">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="0,1,8,0"/><TextBlock Text="Ask"/></StackPanel>
                </Button>
                <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" FontSize="15" Padding="12,9"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Samples}" Margin="0,8,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource ChipButton}" Content="{Binding}" Command="{Binding DataContext.UseSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Busy / errors / warnings -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
            <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="12,8" Margin="0,4,0,0" Visibility="{Binding IsBusy, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Elapsed}" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Gold}"/>
                    <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,12,0" Foreground="{StaticResource Accent}" Background="Transparent" BorderThickness="0"/>
                    <TextBlock Text="{Binding BusyText}" Foreground="{StaticResource Text}"/>
                </DockPanel>
            </Border>
            <Border Background="{StaticResource DangerSoft}" CornerRadius="6" Padding="12,8" Margin="0,4,0,0" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
            </Border>
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource WarningSoft}" CornerRadius="6" Padding="12,6" Margin="0,4,0,0">
                            <TextBlock Text="{Binding}" Foreground="{StaticResource Warning}" TextWrapping="Wrap"/>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Interpreted filter -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12,10" Margin="0,10,0,0" Visibility="{Binding HasResponse, Converter={StaticResource VisibleWhen}}">
            <StackPanel>
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleChip}" IsChecked="{Binding EditFilter}" Content="Adjust filter" VerticalAlignment="Top"/>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="HOW BLADE READ YOUR QUESTION" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ItemsControl ItemsSource="{Binding Response.Chips}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="9,3" Margin="0,2,6,2">
                                    <TextBlock FontSize="12"><Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Muted}"/><Run Text=": "/><Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold"/></TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>

                <!-- Filter editor: the human can correct the model's interpretation -->
                <Grid Margin="0,10,0,0" Visibility="{Binding EditFilter, Converter={StaticResource VisibleWhen}}">
                    <Grid.Resources>
                        <DataTemplate x:Key="ChoiceTemplate">
                            <CheckBox Content="{Binding Display}" IsChecked="{Binding Selected}"/>
                        </DataTemplate>
                        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Label}" Text="OFFENSE"/>
                        <ItemsControl ItemsSource="{Binding Offenses}" ItemTemplate="{StaticResource ChoiceTemplate}" ItemsPanel="{StaticResource Wrap}"/>
                        <TextBlock Style="{StaticResource Label}" Text="DISTRICT" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding Districts}" ItemTemplate="{StaticResource ChoiceTemplate}" ItemsPanel="{StaticResource Wrap}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Label}" Text="PREMISES"/>
                        <ItemsControl ItemsSource="{Binding Premises}" ItemTemplate="{StaticResource ChoiceTemplate}" ItemsPanel="{StaticResource Wrap}"/>
                        <TextBlock Style="{StaticResource Label}" Text="M.O. (ALL MUST MATCH)" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding MoTags}" ItemTemplate="{StaticResource ChoiceTemplate}" ItemsPanel="{StaticResource Wrap}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource Label}" Text="LOOKBACK (MONTHS, BLANK = ALL)"/>
                        <TextBox Text="{Binding LookbackMonths}" Margin="0,4,0,8"/>
                        <TextBlock Style="{StaticResource Label}" Text="HOURS FROM / TO (0-23, BLANK = ANY)"/>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding HourFrom}"/>
                            <TextBox Grid.Column="2" Text="{Binding HourTo}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Label}" Text="SIMILAR TO"/>
                        <TextBox Text="{Binding SemanticQuery}" Margin="0,4,0,8"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Re-run with my filter (skips the AI planner)" Command="{Binding RerunCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="4" Margin="0,12,0,0" Visibility="{Binding HasResponse, Converter={StaticResource VisibleWhen}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Label}" Text="ANSWER" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                                <TextBlock Text="  ·  click any case number to open the report" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <FlowDocumentScrollViewer Document="{Binding Answer}" VerticalScrollBarVisibility="Disabled" IsToolBarVisible="False" Focusable="False"/>
                            <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="AI-generated decision support. Verify against source records before acting. Not probable cause on its own (Policy 830)."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" BorderBrush="{StaticResource Gold}" Visibility="{Binding Response.Series, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="POSSIBLE SERIES (SYSTEM-DETECTED)" Foreground="{StaticResource Gold}"/>
                            <TextBlock Style="{StaticResource Body}" Text="{Binding Response.Series.Summary}" Margin="0,6,0,8"/>
                            <ItemsControl ItemsSource="{Binding Response.Series.Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Width="90" HorizontalContentAlignment="Left" Content="{Binding CaseNumber}" FontFamily="{StaticResource Mono}"
                                                    Command="{Binding DataContext.OpenRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding CaseNumber}"/>
                                            <TextBlock Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" Visibility="{Binding Response.Links, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" AutomationProperties.Name="Open in Link Explorer" Command="{Binding OpenGraphCommand}" Padding="10,4" FontSize="12">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71B;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/><TextBlock Text="Open in Link Explorer"/></StackPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Label}" Text="CONNECTIONS ACROSS SYSTEMS (ENTITY GRAPH)" Foreground="{StaticResource Gold}"/>
                                    <TextBlock FontSize="11.5" Foreground="{StaticResource Muted}" Text="Computed deterministically from LPR, field interviews, bookings, pawn and report data — not generated by the AI."/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Response.Links}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource Panel}" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource Badge}" Background="{Binding Kind, Converter={StaticResource KindBrush}}">
                                                        <TextBlock Text="{Binding Kind}" FontSize="9.5" FontWeight="Bold" Foreground="#0B1220"/>
                                                    </Border>
                                                    <Button Style="{StaticResource LinkButton}" Content="{Binding EntityLabel}" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.ExploreCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding EntityId}"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Body}" FontSize="12.5" Margin="0,4,0,0"/>
                                                <Expander Header="Evidence" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                                                    <ItemsControl ItemsSource="{Binding Evidence}" Margin="14,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" FontSize="11.5" Foreground="{StaticResource Text}" TextWrapping="Wrap" Margin="0,1"/></DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" Margin="2,0,0,6" Text="MATCHING RECORDS (ROLE-FILTERED) · DOUBLE-CLICK TO OPEN"/>
                <DataGrid x:Name="Grid" ItemsSource="{Binding Response.Results}">
                    <DataGrid.InputBindings>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding OpenRecordCommand}" CommandParameter="{Binding SelectedItem, ElementName=Grid}"/>
                    </DataGrid.InputBindings>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="26">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Gold}" ToolTip="{Binding SeriesReason}"
                                               Visibility="{Binding InSeries, Converter={StaticResource VisibleWhen}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Case" Binding="{Binding CaseNumber}" Width="82"/>
                        <DataGridTextColumn Header="Occurred" Binding="{Binding OccurredFrom, StringFormat=yyyy-MM-dd HH:mm}" Width="112"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*"/>
                        <DataGridTextColumn Header="M.O." Binding="{Binding MoTags}" Width="1.4*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="88"/>
                        <DataGridTextColumn Header="Rel." Binding="{Binding Relevance, StringFormat=0.00}" Width="44"/>
                    </DataGrid.Columns>
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Snippet}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="34,0,12,8"/>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- Under the hood side panel -->
        <Border Grid.Column="1" Grid.Row="2" Grid.RowSpan="3" Width="440" Margin="14,10,0,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"
                Visibility="{Binding ShowTrace, Converter={StaticResource VisibleWhen}}">
            <v:UnderTheHoodView DataContext="{Binding Trace}"/>
        </Border>
    </Grid>
</UserControl>
