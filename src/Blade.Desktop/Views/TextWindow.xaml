<Window x:Class="Blade.Desktop.Views.TextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="Sub" Style="{StaticResource Label}"/>
            <TextBlock x:Name="Head" Style="{StaticResource H1}" Margin="0,4,0,12"/>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click"/>
        <Border Style="{StaticResource CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="Body" Style="{StaticResource Body}" FontSize="14"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
