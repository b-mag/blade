<UserControl x:Class="Blade.Desktop.Views.RoiSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: RoiSummaryPageViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1250" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Label}" Text="OPPORTUNITIES" Foreground="{StaticResource Gold}"/>
            <TextBlock Style="{StaticResource H1}" Text="Where local AI pays off first" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource Body}" FontSize="14.5" Text="{Binding Summary.Intro}" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Summary.Notes}" Margin="0,6,0,0"/>

            <ItemsControl ItemsSource="{Binding Ranked}" Margin="0,14,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                HorizontalContentAlignment="Stretch" Padding="0" Margin="0,0,0,8" Background="{StaticResource Card}">
                            <Grid Margin="14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding RoiRank, StringFormat=#{0}}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource Gold}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Tagline}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding EffortDetail}" Foreground="{StaticResource Muted}" FontSize="11.5" TextWrapping="Wrap" HorizontalAlignment="Left" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center" Background="{Binding Effort, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{Binding Effort, Converter={StaticResource StatusBrush}}"><Run Text="EFFORT "/><Run Text="{Binding Effort, Mode=OneWay}"/></TextBlock>
                                </Border>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
