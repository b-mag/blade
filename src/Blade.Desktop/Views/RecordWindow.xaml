<Window x:Class="Blade.Desktop.Views.RecordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="760" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13">
    <!-- DataContext: Blade.Core.IncidentDetail -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{StaticResource DangerSoft}" CornerRadius="10" Padding="10,3" VerticalAlignment="Top">
                    <TextBlock Text="SYNTHETIC RECORD" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Danger}"/>
                </Border>
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="INCIDENT REPORT (RMS · READ-ONLY · THIS VIEW IS AUDITED)"/>
                    <TextBlock Style="{StaticResource H1}" Margin="0,4,0,0"><Run Text="{Binding CaseNumber, Mode=OneWay}" Foreground="{StaticResource Gold}"/><Run Text="  "/><Run Text="{Binding OffenseDescription, Mode=OneWay}"/></TextBlock>
                    <TextBlock Style="{StaticResource MutedText}" Text="{Binding Location}" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,14,20,20">
                <UniformGrid Columns="4">
                    <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource Label}" Text="OCCURRED"/><TextBlock Text="{Binding OccurredFrom, StringFormat=yyyy-MM-dd HH:mm}"/></StackPanel>
                    <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource Label}" Text="REPORTED"/><TextBlock Text="{Binding ReportedAt, StringFormat=yyyy-MM-dd HH:mm}"/></StackPanel>
                    <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource Label}" Text="DISTRICT / PREMISES"/><TextBlock><Run Text="{Binding District, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding PremiseType, Mode=OneWay}"/></TextBlock></StackPanel>
                    <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource Label}" Text="STATUS"/><TextBlock Text="{Binding Status}"/></StackPanel>
                    <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource Label}" Text="M.O."/><TextBlock Text="{Binding MoTags}" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource Label}" Text="REPORTING DEPUTY"/><TextBlock Text="{Binding Deputy}" TextWrapping="Wrap"/></StackPanel>
                    <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource Label}" Text="CAD CALL"/><TextBlock Text="{Binding CadCallNumber}"/></StackPanel>
                    <StackPanel Margin="0,0,10,10"><TextBlock Style="{StaticResource Label}" Text="SENSITIVITY"/><TextBlock Text="{Binding Sensitivity}"/></StackPanel>
                </UniformGrid>

                <Border Style="{StaticResource CardBorder}" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="NARRATIVE"/>
                        <TextBlock Style="{StaticResource Body}" FontSize="14" Text="{Binding Narrative}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="PERSONS"/>
                            <ItemsControl ItemsSource="{Binding Persons}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Role}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <Button Style="{StaticResource LinkButton}" Content="{Binding Name}" HorizontalAlignment="Left" Click="Person_Click" Tag="{Binding Id}"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="VEHICLES"/>
                            <ItemsControl ItemsSource="{Binding Vehicles}" Margin="0,6,0,6">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Role}" FontSize="11" Foreground="{StaticResource Muted}"/>
                                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Vehicle_Click" Tag="{Binding Plate}">
                                                <TextBlock><Run Text="{Binding Plate, Mode=OneWay}"/><Run Text=" " /><Run Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource Muted}" FontWeight="Normal"/></TextBlock>
                                            </Button>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Label}" Text="PROPERTY"/>
                            <ItemsControl ItemsSource="{Binding Property}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StringFormat=• {0}}" FontSize="12" TextWrapping="Wrap" Margin="0,1"/></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Show this case in Link Explorer" Click="Explore_Click" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
