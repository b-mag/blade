<UserControl x:Class="Blade.Desktop.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: HomePageViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1250" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Label}" Text="SECURITY &amp; GOVERNANCE" Foreground="{StaticResource Gold}"/>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Content.Title}" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource Body}" FontSize="14.5" Text="{Binding Content.Intro}" Margin="0,8,0,0"/>

            <Border Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,16,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Gold}" Margin="0,2,12,0"/>
                    <StackPanel>
                        <TextBlock Text="WHAT THIS PROOF OF CONCEPT IS — AND ISN'T" Style="{StaticResource Label}" Foreground="{StaticResource Gold}"/>
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Content.PocStatement}" Margin="0,4,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                <TextBlock Text="Status key:" Foreground="{StaticResource Muted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}"><TextBlock Text="Implemented in POC" FontSize="11" Foreground="{StaticResource Success}" FontWeight="SemiBold"/></Border>
                <Border Style="{StaticResource Badge}" Background="{StaticResource WarningSoft}"><TextBlock Text="Stubbed in POC" FontSize="11" Foreground="{StaticResource Warning}" FontWeight="SemiBold"/></Border>
                <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoft}"><TextBlock Text="Production design" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Border>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Content.Sections}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,12,12,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding Heading}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,6,0,0" Fill="{Binding InPoc, Converter={StaticResource StatusBrush}}"/>
                                                <StackPanel Grid.Column="1">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1" Background="{Binding InPoc, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                                            <TextBlock Text="{Binding InPoc}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding InPoc, Converter={StaticResource StatusBrush}}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Text="{Binding Detail}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
