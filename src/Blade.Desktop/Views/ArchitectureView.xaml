<UserControl x:Class="Blade.Desktop.Views.ArchitectureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:Blade.Desktop.Infrastructure">
    <!-- DataContext: ArchitecturePageViewModel -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1250" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Label}" Text="ARCHITECTURE &amp; DEPLOYMENT" Foreground="{StaticResource Gold}"/>
            <TextBlock Style="{StaticResource H1}" Text="How BLADE fits inside your network" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource Body}" FontSize="14.5" Text="{Binding Content.Intro}" Margin="0,8,0,0"/>

            <!-- Topology diagram -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="DATA FLOW (AS BUILT IN THIS POC)"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style x:Key="Box" TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource Panel}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>
                            <Style x:Key="Arrow" TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE72A;"/>
                                <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
                                <Setter Property="FontSize" Value="20"/>
                                <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>
                        <StackPanel>
                            <Border Style="{StaticResource Box}" BorderBrush="{StaticResource Accent}">
                                <StackPanel>
                                    <TextBlock Text="Workstation / MDT" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="BLADE desktop (WPF). UI only — no model access, no keys, no direct database access."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Box}" BorderBrush="{StaticResource Line}">
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="Identity: POC role switcher → production AD / Entra ID + MFA, roles from groups."/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource Arrow}"/>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Box}" BorderBrush="{StaticResource Gold}">
                                <StackPanel>
                                    <TextBlock Text="BLADE API server (ASP.NET Core)" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="Role filter → query planner → hybrid retrieval (SQL + BM25 + vector) → entity graph → grounded answer → citation guard → PII filter → audit."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Box}" BorderBrush="{StaticResource Success}">
                                <StackPanel>
                                    <TextBlock Text="Hash-chained audit store" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="Every query, answer, record view and denial. Production: WORM storage + SIEM forwarding."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Style="{StaticResource Arrow}"/>
                        <StackPanel Grid.Column="4">
                            <Border Style="{StaticResource Box}" BorderBrush="{StaticResource Violet}">
                                <StackPanel>
                                    <TextBlock Text="Local model runtime (Ollama)" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="qwen3:8b (chat) + nomic-embed-text (embeddings) on agency hardware. No outbound internet required."/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Box}" BorderBrush="{StaticResource Line}">
                                <StackPanel>
                                    <TextBlock Text="Read-only data replicas" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="Your RMS / CAD / JMS / LPR / pawn data + policy manual → vectors, keyword index and entity graph. AI never writes to systems of record."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Content.Sections}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,12,12,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource H2}" Text="{Binding Heading}" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Text="{Binding Detail}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource H2}" Text="Hardware sizing (estimates — validate with a load test on your data)" Margin="0,20,0,8"/>
            <DataGrid ItemsSource="{Binding Content.Sizing}" HeadersVisibility="Column" inf:ScrollBehavior.BubbleWheel="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tier" Binding="{Binding Tier}" Width="140"/>
                    <DataGridTemplateColumn Header="Hardware" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Hardware}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Models" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Models}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Users" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Users}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Notes" Width="3*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
