<UserControl x:Class="Blade.Desktop.Views.AuditView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,16,22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="Audit Log"/>
            <TextBlock Style="{StaticResource MutedText}" Text="Every AI question, generated answer, record view and denied attempt — append-only and SHA-256 hash-chained, so any edit or deletion is detectable. This is what a CJIS auditor reviews."/>
            <WrapPanel Margin="0,12,0,0">
                <TextBlock Text="User" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Text="{Binding FilterUser}" Width="150" Margin="0,0,14,0"/>
                <TextBlock Text="Action" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding FilterAction}" Width="150" Margin="0,0,14,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0"/>
                <Button Command="{Binding VerifyCommand}" AutomationProperties.Name="Verify hash chain">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Margin="0,1,6,0"/><TextBlock Text="Verify hash chain"/></StackPanel>
                </Button>
            </WrapPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <Border Background="{StaticResource DangerSoft}" CornerRadius="6" Padding="12,8" Margin="0,0,0,6" Visibility="{Binding Error, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
            </Border>
            <Border CornerRadius="6" Padding="12,8" Margin="0,0,0,6" Visibility="{Binding Verify, Converter={StaticResource VisibleWhen}}"
                    Background="{Binding Verify.Valid, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                <TextBlock Text="{Binding Verify.Message}" FontWeight="SemiBold" Foreground="{Binding Verify.Valid, Converter={StaticResource StatusBrush}}"/>
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="44"/>
                <DataGridTextColumn Header="Time (UTC)" Binding="{Binding TimestampUtc, StringFormat=MM-dd HH:mm:ss}" Width="98"/>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="96"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="86"/>
                <DataGridTextColumn Header="Workstation" Binding="{Binding Workstation}" Width="96"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="104"/>
                <DataGridTemplateColumn Header="Outcome" Width="96">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><TextBlock Text="{Binding Outcome}" FontWeight="SemiBold" Foreground="{Binding Outcome, Converter={StaticResource StatusBrush}}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Question / detail" Binding="{Binding Question}" Width="2*"/>
                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="72"/>
                <DataGridTextColumn Header="ms" Binding="{Binding LatencyMs}" Width="56"/>
                <DataGridTextColumn Header="Tokens out" Binding="{Binding CompletionTokens}" Width="66"/>
            </DataGrid.Columns>
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel Margin="12,2,12,10">
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Muted}"><Run Text="Detail: " FontWeight="SemiBold"/><Run Text="{Binding Detail, Mode=OneWay}"/></TextBlock>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Muted}"><Run Text="Records returned: " FontWeight="SemiBold"/><Run Text="{Binding RecordsReturned, Mode=OneWay}"/></TextBlock>
                        <TextBlock FontSize="11.5" TextWrapping="Wrap" Foreground="{StaticResource Muted}"><Run Text="Records cited: " FontWeight="SemiBold"/><Run Text="{Binding RecordsCited, Mode=OneWay}"/></TextBlock>
                        <TextBlock FontSize="11" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}"><Run Text="hash "/><Run Text="{Binding Hash, Mode=OneWay}"/></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>

        <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="USAGE BY USER" Margin="2,14,0,6"/>
        <DataGrid Grid.Row="4" ItemsSource="{Binding Usage}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="*"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="*"/>
                <DataGridTextColumn Header="AI queries" Binding="{Binding AiQueries}" Width="*"/>
                <DataGridTextColumn Header="Record views" Binding="{Binding RecordViews}" Width="*"/>
                <DataGridTextColumn Header="Denied attempts" Binding="{Binding Denied}" Width="*"/>
                <DataGridTextColumn Header="Tokens" Binding="{Binding Tokens, StringFormat=N0}" Width="*"/>
                <DataGridTextColumn Header="Last activity (UTC)" Binding="{Binding LastActivityUtc, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
