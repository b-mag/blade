<UserControl x:Class="Blade.Desktop.Views.DataReadinessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:Blade.Desktop.Infrastructure">
    <!-- DataContext: DataReadinessPageViewModel. All text comes from Content/content.json (dataReadiness). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1250" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Label}" Text="DATA READINESS" Foreground="{StaticResource Gold}"/>
            <TextBlock Style="{StaticResource H1}" Text="Getting your data ready for AI retrieval" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource Body}" FontSize="14.5" Text="{Binding Content.Intro}" Margin="0,8,0,0"/>

            <!-- Short answer -->
            <Border Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource Gold}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Gold}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                    <TextBlock Style="{StaticResource Body}" FontSize="14" Text="{Binding Content.ShortAnswer}"/>
                </DockPanel>
            </Border>

            <!-- Pipeline: existing records vs new records -->
            <TextBlock Style="{StaticResource H2}" Text="Bringing one source online" Margin="0,22,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" Text="The same six steps for every database, API or document store. Existing records are loaded once; new records flow through the same steps automatically."/>
            <Border Style="{StaticResource CardBorder}" Margin="0,10,0,0" Padding="0">
                <StackPanel>
                    <Grid Margin="16,12,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="STEP"/>
                        <TextBlock Grid.Column="1" Style="{StaticResource Label}" Text="EXISTING RECORDS (ONE-TIME BACKFILL)" Foreground="{StaticResource Accent}"/>
                        <TextBlock Grid.Column="3" Style="{StaticResource Label}" Text="NEW RECORDS (ONGOING, AUTOMATIC)" Foreground="{StaticResource Success}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Content.Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="230"/><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                            <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource AccentSoft}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Number}" FontWeight="Bold" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Width="180"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Style="{StaticResource Body}" FontSize="12.5" Text="{Binding Existing}"/>
                                        <TextBlock Grid.Column="3" Style="{StaticResource Body}" FontSize="12.5" Text="{Binding Ongoing}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Which source first -->
            <TextBlock Style="{StaticResource H2}" Text="Which source first?" Margin="0,22,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Content.PrioritizationIntro}"/>
            <DataGrid ItemsSource="{Binding Content.Sources}" HeadersVisibility="Column" inf:ScrollBehavior.BubbleWheel="True" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Wave" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Badge}" Background="{StaticResource GoldSoft}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Wave}" FontWeight="Bold" Foreground="{StaticResource Gold}" FontSize="11.5"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Source" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Source}" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Unlocks" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Unlocks}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Typical readiness" Width="3*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Readiness}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Phases -->
            <ItemsControl ItemsSource="{Binding Content.Phases}" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding Duration}" Foreground="{StaticResource Gold}" FontSize="12" Margin="0,2,0,6"/>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Text="{Binding Detail}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Effort -->
            <TextBlock Style="{StaticResource H2}" Text="Effort by kind of source" Margin="0,22,0,8"/>
            <DataGrid ItemsSource="{Binding Content.Effort}" HeadersVisibility="Column" inf:ScrollBehavior.BubbleWheel="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Kind of source" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SourceType}" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Typical time" Width="120">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Time}" Foreground="{StaticResource Gold}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Main work" Width="3*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding MainWork}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Skills" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Skills}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" FontStyle="Italic" Text="{Binding Content.EffortNote}" Margin="0,6,0,0"/>

            <!-- Ready enough -->
            <Border Style="{StaticResource CardBorder}" Margin="0,22,0,0" BorderBrush="{StaticResource Success}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="HOW YOU KNOW A SOURCE IS READY ENOUGH" Foreground="{StaticResource Success}"/>
                    <ItemsControl ItemsSource="{Binding Content.ReadyChecks}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3,16,3">
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Success}" Margin="0,3,8,0" VerticalAlignment="Top"/>
                                    <TextBlock Style="{StaticResource Body}" FontSize="12.5" Text="{Binding}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Reference pattern: SQL Server -->
            <TextBlock Style="{StaticResource H2}" Text="Reference pattern: SQL Server" Margin="0,22,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Content.SqlServer.Intro}"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="7*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="DESIGN RULES" Foreground="{StaticResource Gold}"/>
                        <ItemsControl ItemsSource="{Binding Content.SqlServer.Principles}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3,0,5">
                                        <TextBlock DockPanel.Dock="Left" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource Gold}" Margin="0,4,8,0" VerticalAlignment="Top"/>
                                        <TextBlock Style="{StaticResource Body}" FontSize="12.5" Text="{Binding}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="SIDE TABLES (IN THEIR OWN DATABASE)" Foreground="{StaticResource Gold}"/>
                        <TextBox Style="{StaticResource CodeBox}" Text="{Binding Content.SqlServer.Ddl, Mode=OneWay}" Margin="0,8,0,0"
                                 MaxHeight="10000" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                 inf:ScrollBehavior.BubbleWheel="True"/>
                    </StackPanel>
                </Border>
            </Grid>
            <TextBlock Style="{StaticResource Label}" Text="ONE SHARED VECTOR TABLE, OR ONE PER SOURCE?" Margin="0,14,0,6"/>
            <DataGrid ItemsSource="{Binding Content.SqlServer.Options}" HeadersVisibility="Column" inf:ScrollBehavior.BubbleWheel="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Aspect}" FontWeight="SemiBold" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="One shared table (recommended)" Width="3*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Shared}" TextWrapping="Wrap" Foreground="{StaticResource Success}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="One table per source" Width="3*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding PerSource}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Style="{StaticResource MutedText}" FontSize="12" FontStyle="Italic" Text="{Binding Content.SqlServer.VersionNote}" Margin="0,6,0,0"/>

            <!-- Choosing the embedding model -->
            <TextBlock Style="{StaticResource H2}" Text="Choosing the embedding model (decide once)" Margin="0,22,0,4"/>
            <TextBlock Style="{StaticResource MutedText}" Text="{Binding Content.EmbeddingModels.Intro}"/>
            <ItemsControl ItemsSource="{Binding Content.EmbeddingModels.Models}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,12,12,0">
                            <StackPanel>
                                <Border Style="{StaticResource Badge}" Background="{StaticResource GoldSoft}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Tag}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Gold}"/>
                                </Border>
                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Mono}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,2"/>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" Text="{Binding Facts}"/>
                                <TextBlock Style="{StaticResource Body}" FontSize="12.5" Text="{Binding Why}" Margin="0,8,0,10"/>
                                <ItemsControl ItemsSource="{Binding Ratings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/><ColumnDefinition Width="62"/><ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Dimension}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Top"><Run Text="{Binding Score, Converter={StaticResource Dots}, ConverterParameter=filled, Mode=OneWay}" Foreground="{StaticResource Gold}"/><Run Text="{Binding Score, Converter={StaticResource Dots}, ConverterParameter=empty, Mode=OneWay}" Foreground="#4A5568"/></TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Note}" FontSize="11.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Background="{StaticResource AccentSoft}" CornerRadius="8" Padding="16,12" Margin="0,12,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource Accent}" Margin="0,2,12,0" VerticalAlignment="Top"/>
                    <TextBlock Style="{StaticResource Body}" FontSize="13.5" Text="{Binding Content.EmbeddingModels.Shortlist}"/>
                </DockPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Content.EmbeddingModels.Notes}" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,3,12,3">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,8,0" VerticalAlignment="Top"/>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Text="{Binding}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- FAQ -->
            <TextBlock Style="{StaticResource H2}" Text="Common questions from technical teams" Margin="0,22,0,0"/>
            <ItemsControl ItemsSource="{Binding Content.Faq}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,12,12,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Question}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" Text="{Binding Answer}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
