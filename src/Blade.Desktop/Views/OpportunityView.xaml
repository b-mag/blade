<UserControl x:Class="Blade.Desktop.Views.OpportunityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: OpportunityPageViewModel -->
    <UserControl.Resources>
        <DataTemplate x:Key="Bullet">
            <DockPanel Margin="0,0,0,6">
                <TextBlock DockPanel.Dock="Left" Text="•" Foreground="{StaticResource Gold}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding}" Style="{StaticResource Body}" FontSize="13"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28" MaxWidth="1250" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Label}" Foreground="{StaticResource Gold}"><Run Text="OPPORTUNITY · ROI RANK #"/><Run Text="{Binding Content.RoiRank, Mode=OneWay}"/></TextBlock>
                <Border Style="{StaticResource Badge}" Margin="12,0,0,0" Background="{Binding Content.Effort, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                    <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{Binding Content.Effort, Converter={StaticResource StatusBrush}}"><Run Text="EFFORT "/><Run Text="{Binding Content.Effort, Mode=OneWay}"/></TextBlock>
                </Border>
                <Border Style="{StaticResource Badge}" Background="{StaticResource Panel}">
                    <TextBlock Text="CONCEPT — NOT IMPLEMENTED IN THIS POC" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Content.Title}" Margin="0,6,0,0"/>
            <TextBlock Style="{StaticResource Body}" FontSize="15" Foreground="{StaticResource Gold}" Text="{Binding Content.Tagline}" Margin="0,4,0,0"/>

            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="THE PROBLEM TODAY"/>
                    <TextBlock Style="{StaticResource Body}" FontSize="14" Text="{Binding Content.Problem}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="12"/><RowDefinition/><RowDefinition Height="12"/><RowDefinition/></Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="WHAT THE AI DOES" Foreground="{StaticResource Accent}"/>
                        <ItemsControl ItemsSource="{Binding Content.AiApproach}" ItemTemplate="{StaticResource Bullet}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="RETURN ON INVESTMENT" Foreground="{StaticResource Success}"/>
                        <ItemsControl ItemsSource="{Binding Content.Roi}" ItemTemplate="{StaticResource Bullet}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="RUNS LOCALLY ON" Foreground="{StaticResource Violet}"/>
                        <ItemsControl ItemsSource="{Binding Content.LocalStack}" ItemTemplate="{StaticResource Bullet}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="DATA NEEDED"/>
                        <ItemsControl ItemsSource="{Binding Content.DataNeeded}" ItemTemplate="{StaticResource Bullet}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="INTEGRATION WITH YOUR SYSTEMS"/>
                        <ItemsControl ItemsSource="{Binding Content.Integration}" ItemTemplate="{StaticResource Bullet}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="RISKS &amp; GUARDRAILS" Foreground="{StaticResource Warning}"/>
                        <ItemsControl ItemsSource="{Binding Content.Risks}" ItemTemplate="{StaticResource Bullet}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{StaticResource Panel}" CornerRadius="8" Padding="14,10" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Body}"><Run Text="Effort: " FontWeight="SemiBold"/><Run Text="{Binding Content.EffortDetail, Mode=OneWay}"/></TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
