<Window x:Class="Blade.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Blade.Desktop.ViewModels"
        xmlns:v="clr-namespace:Blade.Desktop.Views"
        Title="BLADE — Bureau Linked Analytics &amp; Data Explorer · Kestrel County Sheriff's Office (SYNTHETIC DATA)"
        Width="1500" Height="940" MinWidth="1150" MinHeight="700" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomePageViewModel}"><v:HomeView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ArchitecturePageViewModel}"><v:ArchitectureView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataReadinessPageViewModel}"><v:DataReadinessView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AskViewModel}"><v:AskView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PolicyViewModel}"><v:PolicyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LinkExplorerViewModel}"><v:LinkExplorerView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditViewModel}"><v:AuditView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpportunityPageViewModel}"><v:OpportunityView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RoiSummaryPageViewModel}"><v:RoiSummaryView/></DataTemplate>
        <CollectionViewSource x:Key="NavSource" Source="{Binding Nav}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource GoldSoft}" BorderBrush="{StaticResource Gold}" BorderThickness="1.5">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="19" FontWeight="Bold"><Run Text="BLADE" Foreground="{StaticResource Gold}"/><Run Text="  Bureau Linked Analytics &amp; Data Explorer" FontSize="13" FontWeight="Normal" Foreground="{StaticResource Muted}"/></TextBlock>
                        <TextBlock Text="Kestrel County Sheriff's Office · AI Integration Proof of Concept" FontSize="11.5" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="1" CornerRadius="12" Padding="12,3">
                    <TextBlock Text="SYNTHETIC DATA — FICTIONAL AGENCY · NO REAL CJI" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Danger}"/>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="12" Padding="10,4" Margin="0,0,10,0" Background="{Binding ProviderBadge, Converter={StaticResource StatusBrush}, ConverterParameter=soft}"
                            BorderBrush="{Binding ProviderBadge, Converter={StaticResource StatusBrush}}" BorderThickness="1"
                            ToolTip="{Binding StatusLine}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding ProviderBadge, Converter={StaticResource StatusBrush}}"/>
                            <TextBlock FontSize="11.5" FontWeight="Bold" Foreground="{Binding ProviderBadge, Converter={StaticResource StatusBrush}}">
                                <Run Text="{Binding ProviderBadge, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding System.ChatModel, Mode=OneWay}" FontWeight="Normal"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="SIGNED IN AS (POC ROLE SWITCHER)" Style="{StaticResource Label}" FontSize="9.5"/>
                        <TextBlock Text="{Binding User}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource RoleRadio}" Content="DEPUTY" IsChecked="{Binding IsDeputy}" ToolTip="Sees NORMAL records only"/>
                            <RadioButton Style="{StaticResource RoleRadio}" Content="ANALYST" IsChecked="{Binding IsAnalyst}" ToolTip="Sees NORMAL + JUVENILE records"/>
                            <RadioButton Style="{StaticResource RoleRadio}" Content="SUPERVISOR" IsChecked="{Binding IsSupervisor}" ToolTip="Sees all records, can review the audit log"/>
                            <RadioButton Style="{StaticResource RoleRadio}" Content="AUDITOR" IsChecked="{Binding IsAuditor}" ToolTip="Audit log only; no AI queries"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Start local server" Command="{Binding StartServerCommand}" Padding="10,2" FontSize="11.5"
                        Visibility="{Binding Disconnected, Converter={StaticResource VisibleWhen}}"/>
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Connected, Converter={StaticResource StatusBrush}}"/>
                <TextBlock Text="{Binding StatusLine}" FontSize="11.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <Border DockPanel.Dock="Left" Width="272" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Source={StaticResource NavSource}}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}" Padding="0,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" Margin="18,14,0,6"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="26" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            <Border DockPanel.Dock="Right" Background="{StaticResource SuccessSoft}" CornerRadius="4" Padding="5,0" VerticalAlignment="Center"
                                    Visibility="{Binding Badge, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource Success}"/>
                            </Border>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Page -->
        <ContentControl Content="{Binding CurrentPage}" Focusable="False"/>
    </DockPanel>
</Window>
